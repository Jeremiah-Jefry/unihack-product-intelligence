# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/storage/product_intelligence.db

# OpenAI (required for AI features - not needed for foundation)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Frontend
FRONTEND_URL=http://localhost:8501

# Storage
UPLOAD_DIR=./data/uploads
STORAGE_DIR=./data/storage
